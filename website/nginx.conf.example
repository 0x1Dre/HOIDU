# Ostsicht – Beispiel für Nginx mit PHP-FPM
# Pfade und PHP-Version an Ihren Server anpassen.
# Im http-Block (z. B. /etc/nginx/conf.d/ostsicht-limits.conf):
#   limit_req_zone $binary_remote_addr zone=kontakt:1m rate=10r/m; Zertifikat z. B. mit certbot (Let's Encrypt).

server {
    listen 80;
    server_name ostsicht.ch www.ostsicht.ch;
    return 301 https://ostsicht.ch$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.ostsicht.ch;
    ssl_certificate     /etc/letsencrypt/live/ostsicht.ch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ostsicht.ch/privkey.pem;
    return 301 https://ostsicht.ch$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ostsicht.ch;
    ssl_certificate     /etc/letsencrypt/live/ostsicht.ch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ostsicht.ch/privkey.pem;

    root /var/www/ostsicht;
    index index.html;
    charset utf-8;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;

    location ~* \.(css|js|woff|svg|png)$ {
        expires 30d;
        add_header Cache-Control "public";
    }

    location = /contact.php {
        # Nur kleine, einfache Formularanfragen an PHP weitergeben
        limit_except POST { deny all; }
        client_max_body_size 16k;
        limit_req zone=kontakt burst=3 nodelay;
        if ($content_type !~* "^application/x-www-form-urlencoded") { return 415; }
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/contact.php;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    # Andere PHP-Dateien gibt es nicht
    location ~ \.php$ { return 404; }
    location ~ /(README\.md|nginx\.conf\.example|\.ht|\.git) { deny all; }

    location / {
        try_files $uri $uri/ =404;
    }
}
